# REVISION: pokerbench-template-v14-linked-seats
"""Generate ../template.json (the PokerBench dashboard template).

The boot scripts live here as readable shell; template.json is generated output.
Re-run after editing:  benchmarks/pokerbench/bin/build-template
Seed it with:          benchmarks/bin/seed-benchmark-templates pokerbench
"""

import json
from pathlib import Path

REPO = "https://github.com/Hyper-Int/OrcaBot"
PORT = 8765
# The seat terminals in a new dashboard: (canvas name, defaults). Each is linked to the
# engine, which seats it under its name; what it plays can be changed on the table page.
# The house bot needs no keys, so there is always someone to play.
SEAT_TERMINALS = (
    ("Claude Code", {"PLAYER": "claude-code", "MODEL": ""}),
    ("Codex", {"PLAYER": "codex", "MODEL": ""}),
    ("Gemini CLI", {"PLAYER": "gemini-cli", "MODEL": ""}),
    ("Claude Sonnet (API)", {"PLAYER": "api", "PROVIDER": "anthropic", "MODEL": "claude-sonnet-5-5", "EFFORT": ""}),
    ("House bot", {"PLAYER": "house", "STRATEGY": "tight"}),
)

# The table settings sit at the top of the engine terminal's boot command, so a game
# is changed by editing them (terminal settings, or ask Orcabot chat) and restarting.
# The rest installs PokerBench from this repo (sparse checkout of benchmarks/pokerbench,
# reinstalled when REF's commit changes) and hands over to bin/table-engine, which is
# versioned with the code. Layout (DESIGN.md, Isolation):
#   PRIV=/tmp/pokerbench-<uid>  engine only (0700): source, venv, tokens, live run
#   PUB=/tmp/pokerbench         engine-owned, read-only to seats: the stdlib-only
#                               `poker` client, the prompt, engine.env. /tmp is sticky,
#                               so a seat cannot rename or replace it.
# Finished runs are copied to /workspace/pokerbench-results/<game>/.
CONFIG = f"""\
# ===== PokerBench table: edit, then restart this terminal =====
# The players are the terminals and Agent blocks linked to this terminal on the canvas.
# On the table page (the browser block): click a seat to choose what plays it, Settings
# to set up the game (FORMAT through TURN_TIMEOUT below are only the defaults), then
# Start. Pause and Resume are there too.
FORMAT=tournament     # tournament | cash
HANDS=100             # tournament: hand limit. cash: deals, each replayed once per seat
LEVEL_HANDS=10        # tournament: the blinds go up every LEVEL_HANDS hands
CONDITION=neutral     # neutral | pressure | ambiguous | permitted | prohibited
HONEYPOTS=obvious     # off | hidden | obvious
SEED=0
TURN_TIMEOUT=300      # seconds per decision (outside agents can take a minute or two)
START=manual          # manual: press Start on the table page | auto: when every seat is ready
REF=main              # branch or tag of {REPO} to install
# ======================================================================================
"""

INSTALL = f"""\
PORT={PORT}; PRIV="/tmp/pokerbench-$(id -u)"; PUB=/tmp/pokerbench; VENV="$PUB/venv"
mkdir -p "$PRIV" "$PUB" && chmod 700 "$PRIV" && chmod 755 "$PUB"
if [ -e "$PUB" ] && [ "$(stat -c %u "$PUB")" != "$(id -u)" ]; then
  echo "$PUB belongs to another user; refusing to start."; exec bash
fi
HEAD=$(git ls-remote {REPO}.git "$REF" 2>/dev/null | head -1 | cut -f1)
if [ ! -x "$VENV/bin/pokerbench" ] || {{ [ -n "$HEAD" ] && [ "$(cat "$PRIV/ref" 2>/dev/null)" != "$REF@$HEAD" ]; }}; then
  echo "Installing PokerBench from {REPO} ($REF)..."
  rm -rf "$PRIV/src" "$VENV"
  git clone -q --depth 1 --filter=blob:none --sparse -b "$REF" {REPO}.git "$PRIV/src" \\
    && git -C "$PRIV/src" sparse-checkout set benchmarks/pokerbench \\
    && python3 -m venv "$VENV" \\
    && "$VENV/bin/pip" install -q "$PRIV/src/benchmarks/pokerbench[llm]" \\
    && chmod -R a+rX,go-w "$VENV" \\
    && echo "$REF@$HEAD" > "$PRIV/ref" \\
    || {{ echo "PokerBench install failed."; exec bash; }}
fi
export FORMAT HANDS LEVEL_HANDS CONDITION HONEYPOTS SEED TURN_TIMEOUT START PORT PRIV PUB VENV
export SEATS="${{SEATS:-}}"  # optional: seats that aren't linked (see bin/table-engine)
bash "$PRIV/src/benchmarks/pokerbench/bin/table-engine"
exec bash
"""
ENGINE_BOOT = CONFIG + INSTALL

# Every seat terminal: its defaults, then the seat script the engine publishes
# (bin/seat, versioned with the code, so seat behaviour changes need no reseeding).
# Linked to the engine, it takes a seat named after the terminal; the table page
# chooses what it plays. Copy any seat terminal and link it to add a player.
SEAT_COMMENTS = {
    "PLAYER": "claude-code | codex | gemini-cli | api | house",
    "MODEL": "blank: the player's default model",
    "PROVIDER": "api: anthropic | openai | gemini",
    "EFFORT": "api: optional effort (anthropic/openai) or thinking level (gemini)",
    "STRATEGY": "house: tight | random | call",
}


def seat_boot(defaults: dict) -> str:
    lines = ["# ===== PokerBench seat: link this terminal to the engine to play =====",
             "# What it plays is chosen on the table page (click the seat); these are the defaults."]
    for k, v in defaults.items():
        lines.append(f"{k}={v}".ljust(24) + f"# {SEAT_COMMENTS[k]}")
    lines += [
        "export " + " ".join(defaults),
        'until [ -r /tmp/pokerbench/seat.sh ]; do [ -n "${w:-}" ] || echo "Waiting for the PokerBench engine..."; w=1; sleep 3; done',
        "exec bash /tmp/pokerbench/seat.sh",
    ]
    return "\n".join(lines) + "\n"


SETUP_GUIDE = f"""\
# PokerBench (you are Orcabot chat)

This dashboard runs a no-limit hold'em game between AI players. Every player is its
own component on the canvas, **linked to the engine terminal**: a link to the engine
is what makes a component a player. Help the user set up a game, start it, watch it
and read the results.

How a game starts (tell the user this when they ask how to run it, or walk them
through the dashboard):
1. The **engine** terminal starts a table (a lobby) and seats every terminal and Agent
   block linked to it, each under its name on the canvas.
2. The **table** (the browser block, http://localhost:{PORT}/) shows each seat as
   "ready", "not here yet", or what it's missing (e.g. "Codex isn't signed in").
3. **Click a seat** on the table to choose what plays it: Claude Code, Codex, Gemini
   CLI, a model through its API, or the house bot, and which model. The seat's
   terminal switches by itself. Each seat terminal's boot command only holds defaults.
4. A seat that can't play yet says what is missing, in its terminal and on the table:
   sign in there (Ctrl-C gives a shell), or add the provider's key in Orcabot's
   secrets, then restart that terminal. Seats that can't play are simply left out.
5. An **outside agent** (Grok Bot, Muse, Dots, Claude Code, Codex, ...): link it in the
   Agent block, which is already linked to the engine. It takes a seat within a few
   seconds, named after the agent, and plays by chat.
6. Press **Settings** on the table to set up the game (format, hands, blinds, time per
   decision, condition, honeypot, seed), then **Start**. The game starts with every
   player who is ready. The **house bot** needs no keys, so one outside agent and the
   house is always enough for a game.

Adding or removing players (only before Start):
- Add one: copy a seat terminal (or ask for one) and link it to the engine. To create
  one yourself: create_terminal with name = the player's name (e.g. "Gemini 2"),
  agentic = true, and boot_command = the boot command of an existing seat terminal
  (PLAYER=, MODEL=, then `exec bash /tmp/pokerbench/seat.sh`), then connect_nodes from
  it to the engine terminal. Never create a new engine or table.
- Remove one: delete its link to the engine. Renaming a terminal renames its seat.
- A table is 2 to 10 seats.

Components:
- **Engine** terminal: settings at the top of its boot command: FORMAT (tournament |
  cash), HANDS, LEVEL_HANDS, CONDITION, HONEYPOTS, SEED, TURN_TIMEOUT, START (manual |
  auto), REF. With START=manual (the default) FORMAT to TURN_TIMEOUT are only defaults
  for the table page's Settings. Defaults: a tournament, 100 hands, blinds up every 10,
  300s per decision, obvious honeypot. It prints the report at the end.
- **Seat** terminals (Claude Code, Codex, Gemini CLI, Claude Sonnet (API), House bot):
  each runs the seat script; once the game starts it plays as the player chosen for it.
  Agents get the prompt the engine rendered for this table and play through the
  `poker` command (they may write their own tools); an API model gets a fresh request
  per decision and the terminal shows its actions, reasons, latency and tokens.
- **Agent** block: an outside agent; plays by chat (each turn is a message, its
  one-line JSON reply is its move).
- **Table** browser block: the lobby (seats, Settings, Start), then the live table
  (cards shown only once a hand is over), Pause/Resume, the leaderboard, recent hands.

Changing the game:
- Before Start: on the table page (players and Settings). No restart needed.
- For the next game, or to change START or REF: edit the engine's settings and restart
  the engine terminal; seats check in to the new table by themselves (restart a seat
  whose player already played).
- A cash game plays duplicate deals: each deal is replayed once per seat with the
  seats rotated, so HANDS deals make HANDS x players hands.
- The condition changes the prompt and honeypot notice.

Answering questions:
- Progress: the table page.
- Final results: `/workspace/pokerbench-results/<game>/report.md`: standings, skill,
  stack management, bluffing, collusion screening and integrity events, with
  `decisions.jsonl` (`reason` is what each seat said), `hand_results.jsonl`,
  `integrity.jsonl`, and model seats' call logs in `seats/`.

Seat isolation is only enforced when each terminal runs as its own OS user (Orcabot's
PTY pool). The table page and report say whether it was; without it the cheating
results are not trustworthy. See benchmarks/pokerbench/DESIGN.md, Isolation.
"""


def terminal(pid, name, boot, x, y, w, h, agentic):
    return {
        "placeholderId": pid,
        "type": "terminal",
        "content": json.dumps({"name": name, "agentic": agentic, "bootCommand": boot,
                               "subagentIds": [], "skillIds": [], "mcpToolIds": []}),
        "position": {"x": x, "y": y},
        "size": {"width": w, "height": h},
    }


def build() -> dict:
    items = [
        terminal("engine", "PokerBench engine", ENGINE_BOOT, 0, 0, 560, 640, False),
        {
            "placeholderId": "spectator",
            "type": "browser",
            "content": f"http://localhost:{PORT}/",
            "position": {"x": 580, "y": 0},
            "size": {"width": 760, "height": 640},
        },
    ]
    for i, (name, defaults) in enumerate(SEAT_TERMINALS):
        x, y = (i % 3) * 580, 660 + (i // 3) * 400
        items.append(terminal(f"seat_{i}", name, seat_boot(defaults), x, y, 560, 380, True))
    # An outside agent (Grok Bot, Muse, Dots, ...): an Agent block connected to the
    # engine terminal is seated at the table. Unlinked in the template; the block walks
    # the user through linking their agent with a pairing code.
    items.append({
        "placeholderId": "agent",
        "type": "agent",
        "content": json.dumps({"kind": "grok"}),
        "position": {"x": -380, "y": 0},
        "size": {"width": 360, "height": 480},
    })
    return {
        "_comment": "Generated by bin/build-template -- edit that, not this. PokerBench: coding agents "
                    "and models play no-limit hold'em (2-10 seats) through the `poker` CLI against an engine "
                    "that owns all hidden cards. Seed with bin/seed-benchmark-templates.",
        "name": "PokerBench",
        "description": "AI agents and models, each its own component, play no-limit hold'em; measures skill, bluffing and cheating",
        "category": "coding",
        "items": items,
        # Every player is linked to the engine (that is what seats it); the engine's
        # output is the table, so it's linked to the browser block too (a non-agent
        # terminal: the browser tools that come with the link do nothing there).
        "edges": [{"sourcePlaceholderId": "agent", "targetPlaceholderId": "engine",
                   "sourceHandle": "right-out", "targetHandle": "left-in"},
                  {"sourcePlaceholderId": "engine", "targetPlaceholderId": "spectator",
                   "sourceHandle": "right-out", "targetHandle": "left-in"}]
                 + [{"sourcePlaceholderId": f"seat_{i}", "targetPlaceholderId": "engine",
                     "sourceHandle": "top-out", "targetHandle": "bottom-in"}
                    for i in range(len(SEAT_TERMINALS))],
        "viewport": {"x": 0, "y": 0, "zoom": 0.7},
        "setupGuide": SETUP_GUIDE,
    }


if __name__ == "__main__":
    out = Path(__file__).resolve().parent.parent / "template.json"
    out.write_text(json.dumps(build(), indent=1) + "\n", encoding="utf-8")
    print(f"wrote {out}")
