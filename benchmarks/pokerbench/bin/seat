#!/usr/bin/env bash
# Copyright 2026 Rob Macrae. All rights reserved.
# SPDX-License-Identifier: LicenseRef-Proprietary

# REVISION: pokerbench-seat-v1-linked
# A PokerBench seat terminal. The engine publishes this script as $PUB/seat.sh, and a
# seat terminal's boot command just runs it:
#
#   PLAYER=claude-code   # what this seat plays until the table page says otherwise
#   MODEL=               # blank: the player's default model
#   exec bash /tmp/pokerbench/seat.sh
#
# A terminal takes a seat by being linked to the engine terminal on the canvas; its
# seat is named after the terminal. What it plays (Claude Code, Codex, Gemini CLI, a
# model through its API, the house bot) and with which model is chosen on the table
# page, until Start; this terminal follows. If the player can't play here yet (not
# signed in, no key), it says what's missing, here and on the table page.
#
# Defaults from the boot command: PLAYER (claude-code | codex | gemini-cli | api | house),
# MODEL, PROVIDER and EFFORT (api), STRATEGY (house). SEAT: a seat name from the
# engine's SEATS, for a terminal the engine can't see links for (an older sandbox).
set -u
PUB="${POKER_PUB:-/tmp/pokerbench}"  # where the engine publishes (overridable for tests)
REVISION=pokerbench-seat-v1-linked
echo "[seat] REVISION: $REVISION loaded at $(date -u +%FT%TZ)"
# Ctrl-C: a shell, to sign in. Restart the terminal afterwards to take the seat again.
trap 'echo; echo "A shell: sign in here, then restart this terminal to take the seat again."; exec bash -i' INT

said=
say_once() { [ "$1" = "$said" ] || { echo "$1"; said=$1; }; }

# This terminal's defaults, as JSON for the engine.
DEFAULT=$(python3 -c 'import json,os
e=os.environ.get
p={"kind":e("PLAYER") or "claude-code"}
for k in ("model","provider","effort","strategy"):
    v=e(k.upper())
    if v: p[k]=v
print(json.dumps(p))')

engine_up() {
  [ -r "$PUB/engine.env" ] && . "$PUB/engine.env" && curl -sf -o /dev/null --max-time 3 "$POKER_URL/api/health"
}

# Which seat this terminal plays: the engine maps linked terminals to seats.
my_seat() {
  python3 -c 'import json,os,sys
d=json.load(open(sys.argv[1]))
s=d.get("by_pty",{}).get(os.environ.get("ORCABOT_PTY_ID",""))
if not s and os.environ.get("SEAT","") in d.get("static",[]): s=os.environ["SEAT"]
print(s or "")' "$PUB/seats.json" 2>/dev/null
}

api() {  # method path [json body]: as this seat (its token if readable, else by OS user)
  local tok=()
  [ -r "$POKER_TOKENS_DIR/$SEAT.token" ] && tok=(-H "X-Seat-Token: $(cat "$POKER_TOKENS_DIR/$SEAT.token")")
  curl -s --max-time 10 -X "$1" -H "X-Poker-Seat: $SEAT" ${tok[@]+"${tok[@]}"} -H 'Content-Type: application/json' \
    ${3:+--data-binary "$3"} "$POKER_URL$2"
}

# What to play: sets P_KIND P_MODEL P_PROVIDER P_EFFORT P_STRATEGY P_REV P_STATUS P_IN P_LABEL.
setup() {
  local out
  out=$(api POST /api/seat/setup "{\"default\": $DEFAULT}") || return 1
  python3 -c 'import json,shlex,sys
d=json.loads(sys.argv[1]); p=d.get("player") or {}
kind=p.get("kind","")
names={"claude-code":"Claude Code","codex":"Codex","gemini-cli":"Gemini CLI","house":"House bot","agent":"Agent block"}
label={"api":"%s/%s (API)"%(p.get("provider"),p.get("model"))}.get(kind) or names.get(kind,kind)
if kind in ("claude-code","codex","gemini-cli") and p.get("model"): label+=" (%s)"%p["model"]
v={"P_KIND":kind,"P_MODEL":p.get("model",""),"P_PROVIDER":p.get("provider",""),"P_EFFORT":p.get("effort",""),
   "P_STRATEGY":p.get("strategy","tight"),"P_REV":d.get("rev",0),"P_STATUS":d.get("status",""),
   "P_IN":"1" if d.get("in_game") else "0","P_LABEL":label}
print(" ".join("%s=%s"%(k,shlex.quote(str(x))) for k,x in v.items()))' "$out" 2>/dev/null
}

report() {  # state message: why this seat can't play yet (the table page shows it)
  api POST /api/seat/status "$(python3 -c 'import json,sys; print(json.dumps({"state":sys.argv[1],"message":sys.argv[2]}))' "$1" "$2")" >/dev/null
}

# Can this player play here? Sets NEED (empty if it can), HOWTO and KEY. Orcabot's secrets
# broker puts a placeholder in a key's variable, so a set variable means the key is there.
check() {
  NEED= HOWTO= KEY=
  case "$P_KIND" in
    claude-code)
      [ -n "${ANTHROPIC_API_KEY:-}${CLAUDE_CODE_OAUTH_TOKEN:-}" ] || [ -s "$HOME/.claude/.credentials.json" ] \
        || { NEED="Claude Code isn't signed in"; HOWTO="type claude, run /login, then /exit"; KEY=ANTHROPIC_API_KEY; } ;;
    codex)
      [ -n "${OPENAI_API_KEY:-}" ] || [ -s "${CODEX_HOME:-$HOME/.codex}/auth.json" ] \
        || { NEED="Codex isn't signed in"; HOWTO="type codex login --device-auth"; KEY=OPENAI_API_KEY; } ;;
    gemini-cli)
      if [ -n "${GEMINI_API_KEY:-}${GOOGLE_API_KEY:-}" ] || [ -s "$HOME/.gemini/oauth_creds.json" ]; then
        # With a key, pick it: otherwise Gemini stops at "how would you like to sign in?".
        [ -n "${GEMINI_API_KEY:-}" ] && python3 -c 'import json,os
p=os.path.expanduser("~/.gemini/settings.json")
try: s=json.load(open(p))
except Exception: s={}
a=s.setdefault("security",{}).setdefault("auth",{})
if not a.get("selectedType"):
    a["selectedType"]="gemini-api-key"; os.makedirs(os.path.dirname(p),exist_ok=True); json.dump(s,open(p,"w"),indent=2)'
      else
        NEED="Gemini CLI isn't signed in"; HOWTO="type gemini and choose Sign in with Google, then /quit"; KEY=GEMINI_API_KEY
      fi ;;
    api)
      case "$P_PROVIDER" in anthropic) KEY=ANTHROPIC_API_KEY;; openai) KEY=OPENAI_API_KEY;; *) KEY=GEMINI_API_KEY;; esac
      [ -n "${!KEY:-}" ] || NEED="$P_LABEL needs an API key" ;;
    house) ;;
    "") NEED="no player chosen: pick one on the table page" ;;
    *) NEED="this terminal can't play $P_KIND" ;;
  esac
}

info() {  # how the seat introduces itself (table page, report)
  case "$P_KIND" in
    claude-code) echo "anthropic/claude-code${P_MODEL:+ ($P_MODEL)}" ;;
    codex) echo "openai/codex${P_MODEL:+ ($P_MODEL)}" ;;
    gemini-cli) echo "google/gemini-cli${P_MODEL:+ ($P_MODEL)}" ;;
    api) echo "$P_PROVIDER/$P_MODEL (API)" ;;
    house) echo "house/bot ($P_STRATEGY)" ;;
  esac
}

ready_at=; ready_game=; told=
while :; do
  until engine_up; do say_once "Waiting for the PokerBench engine..."; sleep 2; done
  SEAT=$(my_seat)
  if [ -z "$SEAT" ]; then
    say_once "Not seated: link this terminal to the PokerBench engine terminal on the canvas to take a seat."
    sleep 2; continue
  fi
  export POKER_URL POKER_SEAT="$SEAT" POKER_TOKEN_FILE="$POKER_TOKENS_DIR/$SEAT.token"
  if [ "$POKER_STARTED" = 1 ]; then
    case " $POKER_SEATS " in *" $SEAT "*) [ "$ready_game" = "$POKER_GAME" ] && break;; esac
    say_once "Game $POKER_GAME started without this seat. Waiting for the next game..."
    sleep 3; continue
  fi
  P_STATUS=; eval "$(setup)" 2>/dev/null
  if [ -z "$P_STATUS" ]; then sleep 3; continue; fi  # not seated yet: the engine is catching up
  if [ "$P_REV:$POKER_GAME:$SEAT" != "$ready_at" ]; then
    ready_game=
    check
    if [ -n "$NEED" ]; then
      report needs "$NEED"
      if [ "$told" != "$P_REV:$POKER_GAME:$NEED" ]; then
        echo; echo "Seat $SEAT can't play as $P_LABEL yet: $NEED."
        [ -n "$HOWTO" ] && echo "  To sign in: press Ctrl-C for a shell, $HOWTO, then restart this terminal,"
        [ -n "$KEY" ] && echo "  ${HOWTO:+or }add $KEY in Orcabot's secrets and restart this terminal,"
        echo "  or choose another player for this seat on the table page."
        echo "The game can start without this seat."; echo
        told="$P_REV:$POKER_GAME:$NEED"
      fi
      sleep 3; continue
    fi
    export POKER_SEAT_INFO="$(info)"
    "$PUB/bin/poker" state >/dev/null || { sleep 3; continue; }  # check in
    ready_at="$P_REV:$POKER_GAME:$SEAT"; ready_game=$POKER_GAME; said=
    echo "Seat $SEAT: ready as $P_LABEL. Waiting for Start on the table page..."
  fi
  sleep 2
done

# The game has started with this seat: play.
trap - INT
GAME=$POKER_GAME
eval "$(setup)" 2>/dev/null
export POKER_SEAT_INFO="$(info)"
# POKER_CLI: absolute path for agents whose shell tool runs a login shell, which resets PATH (Codex).
export PATH="$PUB/bin:$PATH" POKER_CLI="$PUB/bin/poker"
echo "Seat $SEAT: in the game. Playing game $GAME as $P_LABEL."
case "$P_KIND" in
  claude-code) claude ${P_MODEL:+--model "$P_MODEL"} --dangerously-skip-permissions "$(cat "$PUB/prompt.txt")" ;;
  # Codex's own sandbox blocks the loopback HTTP the CLI needs; the VM is the sandbox.
  codex) codex ${P_MODEL:+-m "$P_MODEL"} --dangerously-bypass-approvals-and-sandbox "$(cat "$PUB/prompt.txt")" ;;
  # --skip-trust: otherwise Gemini stops at a folder-trust prompt and turns YOLO off.
  gemini-cli) gemini ${P_MODEL:+-m "$P_MODEL"} --yolo --skip-trust -i "$(cat "$PUB/prompt.txt")" ;;
  api)
    # A fresh request per decision; the call log goes to the results once the game is over.
    LOG="$HOME/pokerbench-$GAME-$SEAT.calls.jsonl"
    "$POKER_PB" llm-seat --provider "$P_PROVIDER" --model "$P_MODEL" ${P_EFFORT:+--effort "$P_EFFORT"} --log "$LOG"
    cp "$LOG" "/workspace/pokerbench-results/$GAME/seats/$SEAT.calls.jsonl" 2>/dev/null ;;
  house) "$POKER_PB" bot --strategy "$P_STRATEGY" ;;
esac
echo "Seat $SEAT: done. Restart this terminal to play the next game."
exec bash
