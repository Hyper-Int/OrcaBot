# REVISION: pokerbench-seat-v5-rejoin
# A PokerBench seat. The engine publishes this script as $PUB/seat.sh. A terminal takes a
# seat by being linked to the engine terminal on the canvas; its seat is named after the
# terminal. Two kinds of seat terminal use it:
#
# An agent terminal (Claude Code, Codex, Gemini CLI) runs its agent interactively, like
# any Orcabot agent terminal: you log in there as usual. Its boot command starts this
# script quietly in the background, then the agent:
#
#   MODEL=                  # blank: the default model
#   export MODEL
#   ( until [ -r /tmp/pokerbench/seat.sh ]; do sleep 3; done
#     exec bash /tmp/pokerbench/seat.sh helper anthropic ) >/dev/null 2>&1 &
#   exec claude ${MODEL:+--model "$MODEL"} --dangerously-skip-permissions
#
#   The helper (vendor: anthropic | openai | google) checks the seat in once the agent is
#   signed in and at its prompt (until then the table page says what's missing), and at
#   Start types the poker prompt into this terminal (Orcabot's self-input). The agent
#   plays through the `poker` command, which finds its seat from the link. Its name is
#   given by vendor so the boot command names the agent only where it starts it: Orcabot
#   recognises the agent (and the Codex model picker edits) from that word.
#
# A bot terminal (a model through its API, or the house bot) runs this script in the
# foreground: `exec bash /tmp/pokerbench/seat.sh`, with PLAYER (api | house), MODEL,
# PROVIDER and EFFORT (api), STRATEGY (house) as defaults that the table page can change
# until Start. SEAT: a seat name from the engine's SEATS, for a terminal the engine can't
# see links for (an older sandbox).
#
# A seat terminal that restarts during a game (closed, or stopped by the sandbox) rejoins
# it: a bot terminal plays on, and an agent terminal's helper gives the fresh agent the
# prompt with a note that the game is under way. The engine terminal restarting doesn't
# need any of this: the game carries on (RESUME=auto) and the `poker` client and the
# bots wait for it to come back.
set -u
PUB="${POKER_PUB:-/tmp/pokerbench}"  # where the engine publishes (overridable for tests)
REVISION=pokerbench-seat-v5-rejoin
SOCK=/run/orcabot/privileged.sock
MODE="${1:-play}"

engine_up() {
  [ -r "$PUB/engine.env" ] && . "$PUB/engine.env" && curl -sf -o /dev/null --max-time 3 "$POKER_URL/api/health"
}

# Which seat this terminal plays: the engine maps linked terminals to seats.
# (No python here: it runs every few seconds. seats.json is one "key": "value" per line.)
my_seat() {
  local s=
  [ -n "${ORCABOT_PTY_ID:-}" ] && s=$(sed -n "s/^ *\"${ORCABOT_PTY_ID}\": \"\([^\"]*\)\".*/\1/p" "$PUB/seats.json" 2>/dev/null | head -1)
  if [ -z "$s" ] && [ -n "${SEAT:-}" ]; then  # a seat from SEATS (no links)
    s=$(python3 -c 'import json,os,sys
d=json.load(open(sys.argv[1])); print(os.environ["SEAT"] if os.environ["SEAT"] in d.get("static",[]) else "")' "$PUB/seats.json" 2>/dev/null)
  fi
  echo "$s"
}

api() {  # method path [json body]: as this seat (its token if readable, else by OS user)
  local tok=()
  [ -r "$POKER_TOKENS_DIR/$SEAT.token" ] && tok=(-H "X-Seat-Token: $(cat "$POKER_TOKENS_DIR/$SEAT.token")")
  curl -s --max-time 10 -X "$1" -H "X-Poker-Seat: $SEAT" ${tok[@]+"${tok[@]}"} -H 'Content-Type: application/json' \
    ${3:+--data-binary "$3"} "$POKER_URL$2"
}

# What to play: sets P_KIND P_MODEL P_PROVIDER P_EFFORT P_STRATEGY P_REV P_STATUS P_IN P_LABEL.
setup() {
  local out
  out=$(api POST /api/seat/setup "{\"default\": $DEFAULT}") || return 1
  python3 -c 'import json,shlex,sys
d=json.loads(sys.argv[1]); p=d.get("player") or {}
kind=p.get("kind","")
names={"claude-code":"Claude Code","codex":"Codex","gemini-cli":"Gemini CLI","house":"House bot","agent":"Agent block"}
label={"api":"%s/%s (API)"%(p.get("provider"),p.get("model"))}.get(kind) or names.get(kind,kind)
if kind in ("claude-code","codex","gemini-cli") and p.get("model"): label+=" (%s)"%p["model"]
v={"P_KIND":kind,"P_MODEL":p.get("model",""),"P_PROVIDER":p.get("provider",""),"P_EFFORT":p.get("effort",""),
   "P_STRATEGY":p.get("strategy","tight"),"P_REV":d.get("rev",0),"P_STATUS":d.get("status",""),
   "P_IN":"1" if d.get("in_game") else "0","P_LABEL":label}
print(" ".join("%s=%s"%(k,shlex.quote(str(x))) for k,x in v.items()))' "$out" 2>/dev/null
}

reported= reported_at=0
report() {  # state message: why this seat can't play yet (the table page shows it); again only if it changed, or every 30s
  local now; now=$(date +%s)
  [ "$1:$2" = "$reported" ] && [ "$now" -lt $((reported_at + 30)) ] && return 0
  api POST /api/seat/status "$(python3 -c 'import json,sys; print(json.dumps({"state":sys.argv[1],"message":sys.argv[2]}))' "$1" "$2")" >/dev/null
  reported="$1:$2"; reported_at=$now
}

# Can this player play here? Sets NEED (empty if it can), HOWTO and KEY. Orcabot's secrets
# broker puts a placeholder in a key's variable, so a set variable means the key is there.
check() {
  NEED= HOWTO= KEY=
  case "$P_KIND" in
    claude-code)
      [ -n "${ANTHROPIC_API_KEY:-}${CLAUDE_CODE_OAUTH_TOKEN:-}${OPENROUTER_API_KEY:-}" ] || [ -s "$HOME/.claude/.credentials.json" ] \
        || { NEED="Claude Code isn't signed in"; HOWTO="type claude, run /login, then /exit"; KEY=ANTHROPIC_API_KEY; } ;;
    codex)
      [ -n "${OPENAI_API_KEY:-}${OPENROUTER_API_KEY:-}" ] || [ -s "${CODEX_HOME:-$HOME/.codex}/auth.json" ] \
        || { NEED="Codex isn't signed in"; HOWTO="type codex login --device-auth"; KEY=OPENAI_API_KEY; } ;;
    gemini-cli)
      [ -n "${GEMINI_API_KEY:-}${GOOGLE_API_KEY:-}${OPENROUTER_API_KEY:-}" ] || [ -s "$HOME/.gemini/oauth_creds.json" ] \
        || { NEED="Gemini CLI isn't signed in"; HOWTO="type gemini and choose Sign in with Google, then /quit"; KEY=GEMINI_API_KEY; } ;;
    api)
      case "$P_PROVIDER" in anthropic) KEY=ANTHROPIC_API_KEY;; openai) KEY=OPENAI_API_KEY;; *) KEY=GEMINI_API_KEY;; esac
      [ -n "${!KEY:-}" ] || NEED="$P_LABEL needs an API key" ;;
    house) ;;
    "") NEED="no player chosen: pick one on the table page" ;;
    *) NEED="this terminal can't play $P_KIND" ;;
  esac
}

info() {  # how the seat introduces itself (table page, report)
  case "$P_KIND" in
    claude-code) echo "anthropic/claude-code${P_MODEL:+ ($P_MODEL)}" ;;
    codex) echo "openai/codex${P_MODEL:+ ($P_MODEL)}" ;;
    gemini-cli) echo "google/gemini-cli${P_MODEL:+ ($P_MODEL)}" ;;
    api) echo "$P_PROVIDER/$P_MODEL (API)" ;;
    house) echo "house/bot ($P_STRATEGY)" ;;
  esac
}

# -- this terminal's own screen and keyboard (Orcabot: the privileged socket in the PTY
#    pool, else MCPLocal with this terminal's MCP secret) ----------------------------------
own() {  # method path [json]
  if [ -n "${POKER_OWN_URL:-}" ]; then  # tests
    curl -s --max-time 15 -X "$1" -H 'Content-Type: application/json' ${3:+--data-binary "$3"} "$POKER_OWN_URL$2"
  elif [ -S "$SOCK" ]; then
    curl -s --max-time 15 --unix-socket "$SOCK" -X "$1" -H 'Content-Type: application/json' ${3:+--data-binary "$3"} "http://localhost$2"
  else
    curl -s --max-time 15 -X "$1" -H "X-MCP-Secret: ${ORCABOT_MCP_SECRET:-}" -H 'Content-Type: application/json' \
      ${3:+--data-binary "$3"} "http://127.0.0.1:${ORCABOT_MCP_PORT:-8081}/sessions/${ORCABOT_SESSION_ID:-}/ptys/${ORCABOT_PTY_ID:-}$2"
  fi
}

# A setup question the agent is still waiting on (login, trust this folder, ...): this
# terminal's raw recent output (Orcabot /screen, with its size), rendered as the screen
# shows it now (seat_screen.py), since an agent's interface redraws in place and an
# answered question stays in the output. Empty if none, or if this Orcabot can't say.
screen_sum= WAIT_Q=
waiting_on() {  # sets WAIT_Q
  local hdr body rows cols sum
  hdr=$(mktemp) body=$(mktemp)
  if [ -n "${POKER_OWN_URL:-}" ]; then  # tests
    curl -s --max-time 15 -D "$hdr" -o "$body" "$POKER_OWN_URL/screen"
  elif [ -S "$SOCK" ]; then
    curl -s --max-time 15 --unix-socket "$SOCK" -D "$hdr" -o "$body" "http://localhost/screen"
  else
    curl -s --max-time 15 -H "X-MCP-Secret: ${ORCABOT_MCP_SECRET:-}" -D "$hdr" -o "$body" \
      "http://127.0.0.1:${ORCABOT_MCP_PORT:-8081}/sessions/${ORCABOT_SESSION_ID:-}/ptys/${ORCABOT_PTY_ID:-}/screen"
  fi
  if head -1 "$hdr" | grep -q " 200"; then
    rows=$(grep -i '^x-screen-rows:' "$hdr" | tr -dc 0-9); cols=$(grep -i '^x-screen-cols:' "$hdr" | tr -dc 0-9)
    sum="$(cksum < "$body") $rows $cols"
    if [ "$sum" != "$screen_sum" ]; then  # render only when the screen has changed
      WAIT_Q=$(python3 "$PUB/seat_screen.py" --rows "${rows:-0}" --cols "${cols:-0}" < "$body" 2>/dev/null)
      screen_sum=$sum
    fi
  else
    WAIT_Q=
  fi
  rm -f "$hdr" "$body"
}

type_in() {  # file [clear-command] [extra line]: give the agent the prompt, as if pasted at its prompt
  if [ -n "${2:-}" ]; then
    own POST /input "{\"text\": \"$2\", \"enter\": true}" >/dev/null; sleep 4
  fi
  own POST /input "$(python3 -c 'import json,sys; t=open(sys.argv[1]).read().rstrip("\n")
if sys.argv[2]: t += "\n\n" + sys.argv[2]
print(json.dumps({"text": t, "paste": True, "enter": True}))' "$1" "${3:-}")"
}
MIDGAME="Note: this game is already under way (this terminal restarted during it). Your seat is still in it: start with \`poker wait\`."

# This terminal's defaults, as JSON for the engine.
if [ "$MODE" = helper ]; then
  case "${2:-}" in
    anthropic) PLAYER=claude-code; CLEAR=/clear ;;
    openai) PLAYER=codex; CLEAR=/new ;;
    google) PLAYER=gemini-cli; CLEAR=/clear ;;
    *) echo "seat.sh helper: vendor must be anthropic, openai or google"; exit 2 ;;
  esac
  export PLAYER
fi
DEFAULT=$(python3 -c 'import json,os
e=os.environ.get
p={"kind":e("PLAYER") or "house"}
for k in ("model","provider","effort","strategy"):
    v=e(k.upper())
    if v: p[k]=v
print(json.dumps(p))')

# ---- an agent terminal's helper: in the background, no output on the agent's screen ----------
if [ "$MODE" = helper ]; then
  exec >>"${TMPDIR:-/tmp}/pokerbench-seat-$(id -u)-${ORCABOT_PTY_ID:-local}.log" 2>&1
  echo "[seat] REVISION: $REVISION helper ($PLAYER) loaded at $(date -u +%FT%TZ)"
  ready_at=; ready_game=; given=; given_any=; recheck_at=0
  while :; do
    until engine_up; do sleep 3; done
    SEAT=$(my_seat)
    [ -n "$SEAT" ] || { sleep 3; continue; }
    export POKER_URL POKER_SEAT="$SEAT" POKER_TOKEN_FILE="$POKER_TOKENS_DIR/$SEAT.token"
    if [ "$POKER_STARTED" = 1 ]; then
      if [ "$given" != "$POKER_GAME" ]; then
        case " $POKER_SEATS " in *" $SEAT "*)
          note=
          if [ "$ready_game" != "$POKER_GAME" ]; then
            # This terminal restarted mid-game: a fresh agent, which must be signed in first.
            P_STATUS=; eval "$(setup)" 2>/dev/null; check
            if [ -n "$NEED" ]; then echo "$(date -u +%T) can't rejoin yet: $NEED"; sleep 5; continue; fi
            note=$MIDGAME
          fi
          waiting_on
          if [ -n "$WAIT_Q" ]; then echo "$(date -u +%T) waiting: the agent is showing \"$WAIT_Q\""; sleep 3; continue; fi
          echo "$(date -u +%T) game $POKER_GAME ${note:+under way, rejoining}${note:-started}: giving the agent its prompt"
          type_in "$PUB/prompt.txt" "${given_any:+$CLEAR}" "$note" && given=$POKER_GAME && given_any=1 ;;
        esac
      fi
      sleep 2; continue
    fi
    # Ready for this game: just watch for Start (cheap), and check again every 20s.
    if [ "$ready_at" = "$POKER_GAME:$SEAT" ] && [ "$(date +%s)" -lt "$recheck_at" ]; then sleep 2; continue; fi
    P_STATUS=; eval "$(setup)" 2>/dev/null
    [ -n "$P_STATUS" ] || { sleep 3; continue; }
    check
    if [ -z "$NEED" ]; then
      waiting_on
      [ -n "$WAIT_Q" ] && NEED="$P_LABEL is waiting for you in its terminal (\"$WAIT_Q\")"
    elif [ -n "$KEY" ]; then
      NEED="$NEED: log in in its terminal, or add $KEY in Orcabot's secrets and restart it"
    fi
    if [ -n "$NEED" ]; then
      report needs "$NEED"; ready_at=; ready_game=
      sleep 3; continue
    fi
    if [ "$ready_at" != "$POKER_GAME:$SEAT" ]; then
      export POKER_SEAT_INFO="$(info)"
      "$PUB/bin/poker" state >/dev/null || { sleep 3; continue; }  # check in
      ready_at="$POKER_GAME:$SEAT"; ready_game=$POKER_GAME
      echo "$(date -u +%T) seat $SEAT ready as $P_LABEL"
    fi
    recheck_at=$(( $(date +%s) + 20 ))
    sleep 2
  done
fi

# ---- a bot terminal: in the foreground -------------------------------------------------------
echo "[seat] REVISION: $REVISION loaded at $(date -u +%FT%TZ)"
# Ctrl-C: a shell. Restart the terminal afterwards to take the seat again.
trap 'echo; echo "A shell: restart this terminal to take the seat again."; exec bash -i' INT
said=
say_once() { [ "$1" = "$said" ] || { echo "$1"; said=$1; }; }

ready_at=; ready_game=; told=
while :; do
  until engine_up; do say_once "Waiting for the PokerBench engine..."; sleep 2; done
  SEAT=$(my_seat)
  if [ -z "$SEAT" ]; then
    say_once "Not seated: link this terminal to the PokerBench engine terminal on the canvas to take a seat."
    sleep 2; continue
  fi
  export POKER_URL POKER_SEAT="$SEAT" POKER_TOKEN_FILE="$POKER_TOKENS_DIR/$SEAT.token"
  if [ "$POKER_STARTED" = 1 ]; then
    # In this game: play (also after this terminal restarted mid-game: it rejoins).
    case " $POKER_SEATS " in *" $SEAT "*) break;; esac
    say_once "Game $POKER_GAME started without this seat. Waiting for the next game..."
    sleep 3; continue
  fi
  # Ready: watch for Start every 2s, ask about a switch on the table page every 6s.
  if [ "${ready_game:-}" = "$POKER_GAME" ] && [ "$(date +%s)" -lt "${recheck_at:-0}" ]; then sleep 2; continue; fi
  recheck_at=$(( $(date +%s) + 6 ))
  P_STATUS=; eval "$(setup)" 2>/dev/null
  if [ -z "$P_STATUS" ]; then sleep 3; continue; fi  # not seated yet: the engine is catching up
  if [ "$P_REV:$POKER_GAME:$SEAT" != "$ready_at" ]; then
    ready_game=
    check
    if [ -n "$NEED" ]; then
      report needs "$NEED"
      if [ "$told" != "$P_REV:$POKER_GAME:$NEED" ]; then
        echo; echo "Seat $SEAT can't play as $P_LABEL yet: $NEED."
        [ -n "$KEY" ] && echo "  Add $KEY in Orcabot's secrets and restart this terminal,"
        echo "  or choose another player for this seat on the table page."
        echo "The game can start without this seat."; echo
        told="$P_REV:$POKER_GAME:$NEED"
      fi
      sleep 3; continue
    fi
    export POKER_SEAT_INFO="$(info)"
    "$PUB/bin/poker" state >/dev/null || { sleep 3; continue; }  # check in
    ready_at="$P_REV:$POKER_GAME:$SEAT"; ready_game=$POKER_GAME; said=
    echo "Seat $SEAT: ready as $P_LABEL. Waiting for Start on the table page..."
  fi
  sleep 2
done

# The game has started with this seat: play.
trap - INT
GAME=$POKER_GAME
eval "$(setup)" 2>/dev/null
export POKER_SEAT_INFO="$(info)"
export PATH="$PUB/bin:$PATH" POKER_CLI="$PUB/bin/poker"
echo "Seat $SEAT: in the game. Playing game $GAME as $P_LABEL."
case "$P_KIND" in
  api)
    # A fresh request per decision; the call log goes to the results once the game is over.
    LOG="$HOME/pokerbench-$GAME-$SEAT.calls.jsonl"
    "$POKER_PB" llm-seat --provider "$P_PROVIDER" --model "$P_MODEL" ${P_EFFORT:+--effort "$P_EFFORT"} --log "$LOG"
    cp "$LOG" "/workspace/pokerbench-results/$GAME/seats/$SEAT.calls.jsonl" 2>/dev/null ;;
  house) "$POKER_PB" bot --strategy "$P_STRATEGY" ;;
  *) echo "This terminal plays bots; an agent plays in its own agent terminal (link one to the engine)." ;;
esac
echo "Seat $SEAT: done. Restart this terminal to play the next game."
exec bash
