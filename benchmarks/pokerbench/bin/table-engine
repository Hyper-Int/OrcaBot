#!/usr/bin/env bash
# Copyright 2026 Rob Macrae. All rights reserved.
# SPDX-License-Identifier: LicenseRef-Proprietary

# REVISION: pokerbench-table-engine-v3-agent-blocks
# Runs one PokerBench table from the settings at the top of the engine terminal's
# boot command (see bin/build-template). The boot command installs PokerBench into
# $PRIV and then runs this script with those settings in the environment:
#
#   FORMAT       tournament | cash
#   HANDS        tournament: hand limit; cash: deals (each replayed once per seat)
#   LEVEL_HANDS  tournament: hands per blind level
#   CONDITION    neutral | pressure | ambiguous | permitted | prohibited | losing
#   RIG_SEAT     losing only: the seat dealt coolers
#   HONEYPOTS    off | hidden | obvious
#   SEED, TURN_TIMEOUT
#   SEATS        every seat at the table, space-separated. Each is a seat terminal on
#                the canvas with the same SEAT=: an agent (Claude Code, Codex, ...) or a
#                model played through its provider's API. Seats report who they are.
#                Agent blocks (outside agents: Grok Bot, Muse, Dots, ...) connected to
#                this engine terminal on the canvas are seated too, named after the
#                agent, and played from here by chat (pokerbench agent-seat).
#   PORT, PRIV (engine-only dir), PUB (read-only to seats), VENV (in PUB: model
#   seats run the API player from it)
#
# Seats find the engine through $PUB/engine.env, which also lists who is seated.
set -u
REVISION=pokerbench-table-engine-v3-agent-blocks
echo "[table-engine] REVISION: $REVISION loaded at $(date -u +%FT%TZ)"
PB="$VENV/bin/pokerbench"
SRC="$PRIV/src/benchmarks/pokerbench/pokerbench"

die() { echo "Config error: $*"; echo "Edit the settings at the top of this terminal's boot command and restart it."; exit 1; }
case "$FORMAT" in tournament|cash) ;; *) die "FORMAT must be tournament or cash (got '$FORMAT')";; esac
case "$HONEYPOTS" in off|hidden|obvious) ;; *) die "HONEYPOTS must be off, hidden or obvious";; esac

SEATS_LIST="${SEATS:-}"; unset SEATS; read -r -a SEATS <<<"$SEATS_LIST"
# Agent blocks connected to this terminal: "seat identity" per line.
AGENT_SEATS=()
while read -r seat identity; do
  [ -n "$seat" ] || continue
  case " ${SEATS[*]} " in *" $seat "*) ;; *) SEATS+=("$seat");; esac
  AGENT_SEATS+=("$seat|$identity")
done < <("$PB" agents 2>/dev/null)
N=${#SEATS[@]}
[ "$N" -ge 2 ] && [ "$N" -le 10 ] || die "a table needs 2 to 10 SEATS; got $N"
for s in "${SEATS[@]}"; do [[ "$s" =~ ^[a-z0-9][a-z0-9._-]*$ ]] || die "seat name '$s': use lowercase letters, digits, . _ -"; done
DUP=$(printf '%s\n' "${SEATS[@]}" | sort | uniq -d | head -1); [ -z "$DUP" ] || die "seat '$DUP' appears twice"
join() { local IFS="$1"; shift; echo "$*"; }

# Publish the seat client, the rendered prompt and the engine's address (read-only to seats).
mkdir -p "$PUB/bin" && chmod 755 "$PUB" "$PUB/bin"
cp "$SRC/cli.py" "$PUB/poker_cli.py"
printf '#!/bin/sh\nexec python3 %s/poker_cli.py "$@"\n' "$PUB" > "$PUB/bin/poker"
"$PB" prompt --condition "$CONDITION" --players "$N" --format "$FORMAT" > "$PUB/prompt.txt" || die "unknown CONDITION '$CONDITION'"
chmod 755 "$PUB/bin/poker"; chmod 644 "$PUB/poker_cli.py" "$PUB/prompt.txt"
GAME="$(date -u +%Y%m%d-%H%M%S)"; RUN="$PRIV/runs/$GAME"
rm -rf "$PRIV/tokens"
{ printf 'POKER_URL=http://127.0.0.1:%s\n' "$PORT"
  printf 'POKER_TOKENS_DIR=%s\n' "$PRIV/tokens"
  printf 'POKER_GAME=%s\n' "$GAME"
  printf 'POKER_SEATS="%s"\n' "${SEATS[*]}"
  printf 'POKER_PB=%s\n' "$PB"; } > "$PUB/engine.env"
chmod 644 "$PUB/engine.env"

# Results: the engine's own directory, plus seats/ where seats may drop their own logs
# (model seats copy their call logs there once the game is over). Sticky, so a seat
# can't replace another's file.
OUT="/workspace/pokerbench-results/$GAME"
mkdir -p "$OUT/seats" && chmod 755 "$OUT" && chmod 1777 "$OUT/seats"

ARGS=(--seats "$(join , "${SEATS[@]}")" --format "$FORMAT"
      --condition "$CONDITION" --honeypots "$HONEYPOTS" --seed "$SEED" --turn-timeout "$TURN_TIMEOUT"
      --port "$PORT" --run-dir "$RUN" --tokens-dir "$PRIV/tokens" --exit-when-done)
if [ "$FORMAT" = tournament ]; then ARGS+=(--hands "$HANDS" --level-hands "$LEVEL_HANDS"); else ARGS+=(--deals "$HANDS"); fi
[ -n "${RIG_SEAT:-}" ] && ARGS+=(--rig-seat "$RIG_SEAT")

echo "== PokerBench: $N seats, $FORMAT, $HANDS hands, condition $CONDITION, honeypots $HONEYPOTS =="
echo "   seats: ${SEATS[*]}"
"$PB" serve "${ARGS[@]}" &
ENGINE=$!
until curl -sf -o /dev/null "http://127.0.0.1:$PORT/api/health"; do
  kill -0 $ENGINE 2>/dev/null || { echo "The engine exited before it was ready."; exit 1; }
  sleep 1
done

# Agent blocks play from here: each seat chats with its agent through Orcabot's sandbox.
PIDS=()
for as in ${AGENT_SEATS[@]+"${AGENT_SEATS[@]}"}; do
  seat="${as%%|*}"; identity="${as#*|}"
  until [ -s "$PRIV/tokens/$seat.token" ]; do sleep 1; done
  ( "$PB" agent-seat --agent "$identity" --seat "$seat" --token-file "$PRIV/tokens/$seat.token" \
      --url "http://127.0.0.1:$PORT" --reply-timeout $(( TURN_TIMEOUT > 40 ? TURN_TIMEOUT - 15 : TURN_TIMEOUT - 5 )) \
      --log "$RUN/$seat.calls.jsonl" < /dev/null 2>&1 | sed -u "s/^/[$seat] /" ) &
  PIDS+=($!)
  echo "   agent seat $seat: $identity"
done
echo "Spectate at http://localhost:$PORT/ . Each seat starts in its own terminal."

wait $ENGINE
for p in ${PIDS[@]+"${PIDS[@]}"}; do kill "$p" 2>/dev/null; done
cp -R "$RUN"/. "$OUT"/ && chmod -R a+rX "$OUT"
echo; cat "$OUT/report.md" 2>/dev/null
echo "Results: $OUT"
