#!/usr/bin/env python3
"""Seed (or refresh) every benchmark dashboard template into D1.

Templates are DB-only -- there is no code seed -- so a curated template has to be
written to the `dashboard_templates` table directly. This discovers every
`benchmarks/*/template.json` and upserts each one (delete-by-name then insert),
status='approved' so they show in the New Dashboard grid immediately.

This is the generic path; `slopcodebench/bin/scb-insert-template` delegates here
for the single SlopCodeBench template.

Usage:
  bin/seed-benchmark-templates                  # all templates, desktop d1-shim
  bin/seed-benchmark-templates swebench         # only benchmarks/swebench/template.json
  D1_URL=http://127.0.0.1:9001 AUTHOR_ID=dev-desktop bin/seed-benchmark-templates

For a remote/cloud control plane, export a template instead via the templates API
from an existing dashboard (POST /templates) -- direct INSERT is the local/curated
path.
"""
import datetime
import json
import os
import pathlib
import sys
import urllib.request
import uuid

D1_URL = os.environ.get("D1_URL", "http://127.0.0.1:9001")
AUTHOR_ID = os.environ.get("AUTHOR_ID", "dev-desktop")
AUTHOR_NAME = os.environ.get("AUTHOR_NAME", "OrcaBot")

# REVISION: seed-benchmark-templates-v3-auto-sleep-off
# Benchmark dashboards run unattended (overnight games, long eval matrices), so their
# templates carry Auto sleep off unless template.json says "autoSleep": true. Needs the
# dashboard_templates.auto_sleep column (controlplane initializeDatabase / /init-db).
def auto_sleep(tpl) -> int:
    return 1 if tpl.get("autoSleep") is True else 0


# REVISION: seed-benchmark-templates-v2-stable-id
# A template's id is derived from its name, so re-seeding keeps it: a dashboards page
# loaded before a re-seed still creates from the right template. (A fresh id each time
# made such a page create an empty dashboard: the control plane found no template.)
def template_id(name: str) -> str:
    return str(uuid.uuid5(uuid.NAMESPACE_URL, f"https://orcabot.com/benchmark-templates/{name}"))


# benchmarks/ root (this file lives in benchmarks/bin/).
ROOT = pathlib.Path(__file__).resolve().parent.parent


def q(sql, params):
    req = urllib.request.Request(
        D1_URL.rstrip("/") + "/query",
        data=json.dumps({"sql": sql, "params": params}).encode(),
        headers={"Content-Type": "application/json"},
    )
    return json.load(urllib.request.urlopen(req))


def discover(filter_dirs):
    """Return the template.json paths to seed, optionally limited to named dirs."""
    if filter_dirs:
        paths = []
        for name in filter_dirs:
            p = ROOT / name / "template.json"
            if not p.exists():
                sys.exit(f"no template.json in benchmarks/{name}/")
            paths.append(p)
        return paths
    return sorted(ROOT.glob("*/template.json"))


def upsert(tpl):
    tid = template_id(tpl["name"])
    now = datetime.datetime.utcnow().isoformat()
    q("DELETE FROM dashboard_templates WHERE name = ?", [tpl["name"]])
    q(
        """INSERT INTO dashboard_templates
           (id,name,description,category,author_id,author_name,items_json,edges_json,
            viewport_json,setup_guide,auto_sleep,item_count,is_featured,use_count,status,created_at,updated_at)
           VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)""",
        [
            tid, tpl["name"], tpl["description"], tpl.get("category", "coding"),
            AUTHOR_ID, AUTHOR_NAME,
            json.dumps(tpl["items"]), json.dumps(tpl["edges"]),
            json.dumps(tpl.get("viewport")), tpl.get("setupGuide"), auto_sleep(tpl), len(tpl["items"]),
            1, 0, "approved", now, now,
        ],
    )
    return tid


def _sql_lit(v):
    if v is None:
        return "NULL"
    if isinstance(v, int):
        return str(v)
    return "'" + str(v).replace("'", "''") + "'"


def emit_sql(tpl):
    """Emit DELETE+INSERT SQL for a template (for `wrangler d1 execute --file`)."""
    tid = template_id(tpl["name"])
    now = datetime.datetime.utcnow().isoformat()
    cols = ("id,name,description,category,author_id,author_name,items_json,edges_json,"
            "viewport_json,setup_guide,auto_sleep,item_count,is_featured,use_count,status,created_at,updated_at")
    vals = [
        tid, tpl["name"], tpl["description"], tpl.get("category", "coding"),
        AUTHOR_ID, AUTHOR_NAME,
        json.dumps(tpl["items"]), json.dumps(tpl["edges"]),
        json.dumps(tpl.get("viewport")) if tpl.get("viewport") is not None else None,
        tpl.get("setupGuide"), auto_sleep(tpl), len(tpl["items"]), 1, 0, "approved", now, now,
    ]
    literals = ", ".join(_sql_lit(v) for v in vals)
    return (f"DELETE FROM dashboard_templates WHERE name = {_sql_lit(tpl['name'])};\n"
            f"INSERT INTO dashboard_templates ({cols}) VALUES ({literals});")


def main():
    args = sys.argv[1:]
    sql_mode = "--sql" in args
    args = [a for a in args if a != "--sql"]
    paths = discover(args)

    # --sql: print SQL to stdout for a direct D1 apply (e.g. local wrangler-dev):
    #   benchmarks/bin/seed-benchmark-templates --sql slopcodebench > /tmp/seed.sql
    #   (cd controlplane && npx wrangler d1 execute orcabot-db --local --file /tmp/seed.sql)
    if sql_mode:
        for path in paths:
            print(emit_sql(json.loads(path.read_text())))
        return

    # Ensure the setup_guide column exists (idempotent) so older DBs accept the insert.
    for ddl in ("ALTER TABLE dashboard_templates ADD COLUMN setup_guide TEXT",
                "ALTER TABLE dashboard_templates ADD COLUMN auto_sleep INTEGER NOT NULL DEFAULT 1"):
        try:
            q(ddl, [])
        except Exception:
            pass
    for path in paths:
        tpl = json.loads(path.read_text())
        tid = upsert(tpl)
        print(f"seeded '{tpl['name']}' (id={tid}) from {path.relative_to(ROOT.parent)}")
    print(f"done: {len(paths)} template(s) -> {D1_URL}")


if __name__ == "__main__":
    main()
